PROJECT_NAME=Users Microservice
POSTGRES_DB=users
POSTGRES_HOST=postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
FIRST_USER_EMAIL=admin@admin.com
FIRST_USER_PASSWORD=password
# Dev-only RSA signing key, checked in like the rest of these placeholders.
# Replace it -- base64 of a PEM, on a single line. The `tr` is not optional:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
JWT_PRIVATE_
# users identifies itself with this; canvas pins the same string.
JWT_ISSUER=http://api
JWKS_URL=http://api/.well-known/jwks.json
ACCESS_TOKEN_EXPIRE_MINUTES=10
REDIS_HOST=redis
REDIS_PORT=6379
